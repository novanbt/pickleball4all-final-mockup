{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/coaching",
      "dest": "/coaching.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
